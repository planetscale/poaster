    "@tanstack/react-virtual": "^3.14.25",
    "boring-avatars": "^2.0.4",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.2",
    "motion": "^14.9.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
